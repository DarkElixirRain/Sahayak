# App
APP_NAME=Sahayak
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# CORS (Flutter/web clients)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (Neon Postgres). Leave empty to disable database features.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.us-east-2.aws.neon.tech/DATABASE?sslmode=require

# Groq LLM provider (used in later phases)
GROQ_API_KEY=your_groq_api_key_here