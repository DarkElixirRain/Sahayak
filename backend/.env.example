# App
APP_NAME=Sahayak
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# CORS (Flutter/web clients)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (Neon Postgres). Leave empty to disable database features.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.us-east-2.aws.neon.tech/DATABASE?sslmode=require

# Groq LLM provider (used in later phases)
GROQ_API_KEY=your_groq_api_key_here

# LLM provider abstraction (Phase 5). Any OpenAI-compatible endpoint works.
# LLM_API_KEY takes precedence over GROQ_API_KEY when both are set.
# LLM_MODEL must be a model id your account can access (GET {base_url}/models
# lists them). A retired id surfaces as a controlled provider_error, not a crash.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=
# Optional: override for a self-hosted or proxy OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# Optional: separate database used by integration tests only.
# Never point automated tests at your real development database.
TEST_DATABASE_URL=